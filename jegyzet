    FROM ubuntu:24.04

    ENV DEBIAN_FRONTEND=noninteractive

    # Update packages and install Python 3
    RUN apt-get update && apt-get install -y python3 && rm -rf /var/lib/apt/lists/*
    
    # Set the working directory
    WORKDIR /app
    
